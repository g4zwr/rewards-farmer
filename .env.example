# Rewards Farmer configuration.
#
# Every value below is optional -- the bot runs with none of them set. Copy this
# file to .env only if you want to change something.
#
# Dotenv does not override variables that are already set in the environment, so
# an existing environment variable always wins over this file.


# --- Search queries ---------------------------------------------------------

# Where the search queries come from: "trends" or "llm".
QUERY_SOURCE=trends

# "trends" needs no API key and no setup. Pick "llm" instead if you have one of
# the OpenRouter variables filled in below.
# QUERY_SOURCE=llm


# --- LLM query generation (only for QUERY_SOURCE=llm) -----------------------

LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=
OPENROUTER_TITLE=rewards-farmer

# Or run the model locally through Ollama:
# LLM_PROVIDER=local
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=gemma3:4b
# LOCAL_LLM_API_KEY=

LLM_REQUEST_TIMEOUT_SECONDS=60


# --- Accounts ---------------------------------------------------------------

# Comma-separated browser profile directories to run, one per Microsoft
# account, under the data directory. Leave this empty to use the single default
# profile and add more only once that one works.
#
# Each name becomes a directory, so keep it to letters, digits, dot, dash and
# underscore. Do not end a name with a dot: Windows silently strips it, and two
# entries would end up sharing one profile.
REWARDS_ACCOUNTS=


# --- Browser ----------------------------------------------------------------

# Edge and its driver are found automatically. Only set these if auto-detection
# picks up the wrong one, for example when several versions are installed.
# EDGE_BINARY=
# MSEDGEDRIVER_PATH=

# Keep the driver's own log for diagnosing a launch failure.
# REWARDS_DRIVER_LOG=msedgedriver.log

# Run without a visible window. Leave this off for the first run: you need to
# see the browser to sign in.
REWARDS_HEADLESS=false


# --- Logging ----------------------------------------------------------------

# INFO, DEBUG, WARNING or ERROR. With no log file set, output goes to stdout.
REWARDS_FARMER_LOG_LEVEL=INFO
# REWARDS_FARMER_LOG_FILE=rewards-farmer.log


# --- Windows only -----------------------------------------------------------

# Run the browser on a separate virtual desktop so it cannot steal focus.
# USE_VIRTUAL_DESKTOP=false
# SWITCH_BACK_TO_MAIN_DESKTOP=true
# SWITCH_BACK_DELAY_SECONDS=1.5
# CLEANUP_VIRTUAL_DESKTOP=true


# --- Tests only -------------------------------------------------------------

# Enables the tests that launch a real Edge. Not for normal runs: it is slow
# and it opens a browser. Run them with
#   REWARDS_BROWSER_TESTS=1 python -m unittest discover -s tests
# REWARDS_BROWSER_TESTS=1
