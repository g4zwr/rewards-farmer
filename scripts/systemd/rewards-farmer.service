[Unit]
Description=Microsoft Rewards farmer (at most once per day)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot

# The two paths below are rewritten to the real location when the installer
# copies this file into ~/.config/systemd/user, so a clone anywhere is handled.
# If you copy the file by hand instead, set both of them to your own path, then
# run `systemctl --user daemon-reload`. `systemctl --user cat rewards-farmer`
# prints whatever is actually in effect.
WorkingDirectory=REPO_DIR_PLACEHOLDER
ExecStart=REPO_DIR_PLACEHOLDER/scripts/run_daily.sh

# A run takes roughly a minute or two. The ceiling is well above that on
# purpose: if something wedges, systemd kills the run, and because run_daily.sh
# only marks the day done on a clean exit, the evening slot still picks it up.
TimeoutStartSec=30min

# Yield to anything you are actually doing. This is not latency sensitive, and
# an unattended run should never make the desktop feel slow.
Nice=10

# A timer gets a much smaller environment than your terminal, so the browser
# paths are pinned when they can be found. The installer substitutes the real
# paths and deletes a line whose binary it could not locate, because Selenium
# Manager finds both by itself and a stale path pinned here would be worse than
# no pin at all.
Environment=EDGE_BINARY=EDGE_PLACEHOLDER
Environment=MSEDGEDRIVER_PATH=DRIVER_PLACEHOLDER
